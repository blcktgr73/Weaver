{
  "name": "@palab/weaver-vscode-extension",
  "displayName": "ebrAIn.lab Weaver",
  "description": "Repository-native requirements and task traceability for humans and AI agents.",
  "version": "0.1.5",
  "publisher": "palab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "weaver.openRequirementView",
        "title": "%weaver.command.openRequirementView.title%",
        "icon": "$(preview)"
      },
      {
        "command": "weaver.openRequirementSource",
        "title": "%weaver.command.openRequirementSource.title%"
      },
      {
        "command": "weaver.openOverview",
        "title": "%weaver.command.openOverview.title%"
      },
      {
        "command": "weaver.setUp",
        "title": "%weaver.command.setUp.title%"
      },
      {
        "command": "weaver.scanWorkspace",
        "title": "%weaver.command.scanWorkspace.title%"
      },
      {
        "command": "weaver.setFabricRoot",
        "title": "%weaver.command.setFabricRoot.title%"
      },
      {
        "command": "weaver.cloneRegistered",
        "title": "%weaver.command.cloneRegistered.title%"
      },
      {
        "command": "weaver.openFabricRoot",
        "title": "%weaver.command.openFabricRoot.title%"
      },
      {
        "command": "weaver.showOnOverview",
        "title": "%weaver.command.showOnOverview.title%",
        "icon": "$(project)"
      },
      {
        "command": "weaver.chooseRepositories",
        "title": "%weaver.command.chooseRepositories.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "weaver.refreshRepositoryList",
        "title": "%weaver.command.refreshRepositoryList.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "weaver.openConfigFile",
        "title": "%weaver.command.openConfigFile.title%"
      },
      {
        "command": "weaver.editContributors",
        "title": "%weaver.command.editContributors.title%"
      },
      {
        "command": "weaver.refreshOverview",
        "title": "%weaver.command.refreshOverview.title%",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "ebrAIn.lab Weaver",
      "properties": {
        "weaver.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko"
          ],
          "default": "auto",
          "description": "%weaver.config.language.description%",
          "enumDescriptions": [
            "%weaver.config.language.auto%",
            "%weaver.config.language.en%",
            "%weaver.config.language.ko%"
          ]
        },
        "weaver.fabricRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%weaver.config.fabricRoot.description%"
        },
        "weaver.staleDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "markdownDescription": "%weaver.config.staleDays.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "weaver.openRequirementView",
          "when": "resourceExtname == .md && weaver.documentKind =~ /^(requirement|task)$/ && activeCustomEditorId != weaver.requirementEditor",
          "group": "navigation"
        },
        {
          "command": "weaver.showOnOverview",
          "when": "resourceExtname == .md && weaver.documentKind =~ /^(requirement|task)$/ && activeCustomEditorId != weaver.requirementEditor",
          "group": "navigation"
        },
        {
          "command": "weaver.refreshOverview",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "navigation@1"
        },
        {
          "command": "weaver.chooseRepositories",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@1"
        },
        {
          "command": "weaver.openConfigFile",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@2"
        },
        {
          "command": "weaver.editContributors",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@2.5"
        },
        {
          "command": "weaver.setUp",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@3"
        },
        {
          "command": "weaver.setFabricRoot",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@4"
        },
        {
          "command": "weaver.cloneRegistered",
          "when": "activeWebviewPanelId == 'weaver.overview'",
          "group": "1_weaver@5"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "weaver.requirementEditor",
        "displayName": "%weaver.editor.requirement.displayName%",
        "selector": [
          {
            "filenamePattern": "REQ-*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "weaver",
          "title": "%weaver.viewContainer.title%",
          "icon": "resources/weaver.svg"
        }
      ]
    },
    "views": {
      "weaver": [
        {
          "id": "weaver.actions",
          "name": "%weaver.view.actions.name%"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "check": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap=external --allow-overwrite --outfile=dist/extension.js",
    "package": "npm run bundle && node ../../scripts/package-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@palab/weaver-github": "0.0.1",
    "@palab/weaver-markdown": "0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ebrAIn-Lab-3B/Weaver.git",
    "directory": "apps/vscode-extension"
  }
}
