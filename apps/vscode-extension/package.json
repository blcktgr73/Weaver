{
  "name": "@palab/weaver-vscode-extension",
  "displayName": "PALab Weaver",
  "description": "Repository-native requirements and task traceability for humans and AI agents.",
  "version": "0.0.1",
  "publisher": "palab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "weaver.openRequirementView",
        "title": "Weaver: Open Requirement View",
        "icon": "$(preview)"
      },
      {
        "command": "weaver.openRequirementSource",
        "title": "Weaver: Open Requirement Source"
      },
      {
        "command": "weaver.scanWorkspace",
        "title": "Weaver: Scan Workspace"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "weaver.openRequirementView",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "check": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@palab/weaver-markdown": "0.0.1"
  }
}
