{
  "name": "@palab/weaver-vscode-extension",
  "displayName": "PALab Weaver",
  "description": "Repository-native requirements and task traceability for humans and AI agents.",
  "version": "0.0.1",
  "publisher": "palab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:weaver.openRequirement",
    "onCommand:weaver.scanWorkspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "weaver.openRequirement",
        "title": "Weaver: Open Requirement"
      },
      {
        "command": "weaver.scanWorkspace",
        "title": "Weaver: Scan Workspace"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "check": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
